daemon:
    pidfile: /tmp/xbee2mqtt.pid
    stderr: /tmp/xbee2mqtt.err
    stdout: /tmp/xbee2mqtt.log

    logging_level: 10 # 10=DEBUG, 20=INFO, 30=WARNING, 40=ERROR

general:
    sample_rate: 5
    change_detection: False
    discovery_on_connect: True
    duplicate_check_window: 5
    expose_undefined_topics: False
    default_topic_pattern: /raw/xbee/{address}/{port}

    routes:
        0013a200407b6d06:
            battery: /home/powermeter/sensor/battery
            power: /home/general/power
        0013a200406bfd09:
            adc-7: /home/door/sensor/battery
            dio-12: /home/door/status
        0013a2004092d70b:
            dio-10: /test/dio10
            dio-11: /test/dio11

# Home Assistant MQTT Discovery
# Enables automatic device discovery in Home Assistant
homeassistant:
    # Enable/disable Home Assistant MQTT Discovery feature
    discovery: false

    # MQTT topic prefix for Home Assistant discovery messages
    # Default: homeassistant (matches HA default configuration)
    discovery_prefix: homeassistant

    # Device name pattern for discovered entities
    # Supports placeholders: {alias} (node name), {address} (64-bit XBee address)
    # Example: "XBee {alias}" becomes "XBee Living Room Sensor"
    node_name_pattern: "XBee {alias}"

    # Per-entity settings, keyed by state topic (same keys as processor.filters)
    # Any Home Assistant MQTT discovery field can be set here and replaces the
    # generated value. By default adc-N entities are voltage sensors in mV, so
    # set device_class and unit_of_measurement when a filter converts the value.
    # Setting device_class without a unit drops the default mV unit.
    entities:
        /home/garage/temperature:
            name: "Garage Temperature"
            device_class: temperature
            unit_of_measurement: "°C"
            state_class: measurement

radio:
    port: /dev/ttyUSB0
    baudrate: 57600
    default_port_name: serial

mqtt:
    client_id: xbee2mqtt
    host: localhost
    port: 1883
    username: null
    password: null
    keepalive: 60
    clean_session: False
    qos: 0
    retain: True
    status_topic: xbee2mqtt/%s/status
    set_will: False

processor:
    filters:
        /benavent/door/sensor/battery:
            type: linear
            parameters:
                slope: 1.171875
                offset: 0

        /benavent/door/status:
            type: enum
            parameters:
                1: 'Closed'
                0: 'Open'

        # TMP36 on an ADC pin with a 3.3V reference: raw * 3300 / 1023 mV,
        # then (mV - 500) / 10 gives degrees C
        /home/garage/temperature:
            - type: linear
              parameters:
                  slope: 0.32258
                  offset: -50
            - type: round
              parameters:
                  decimals: 1

